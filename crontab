# Clone monero.fail to /opt/monero.fail

# every 2 hours clean db
0 */2 * * * make -C /opt/monero.fail vacuum

# every 10 minutes validate up to 50 pending nodes
*/10 * * * * make -C /opt/monero.fail validate >> ~/validate.log 2>&1

# every 10 minutes check up to 20 nodes
*/10 * * * * make -C /opt/monero.fail check >> ~/check.log 2>&1

# every 10 minutes validate up to 50 pending LWS instances
*/10 * * * * make -C /opt/monero.fail validate_lws >> ~/validate_lws.log 2>&1

# every 10 minutes check up to 20 LWS instances
*/10 * * * * make -C /opt/monero.fail check_lws >> ~/check_lws.log 2>&1

# every day export nodes to list
20 0 * * * make -C /opt/monero.fail export

# every 30 minutes scrape p2p peers
*/30 * * * * make -C /opt/monero.fail peers >> ~/peers.log 2>&1

# every hour export offline list
0 * * * * make -C /opt/monero.fail html; cp /opt/monero.fail/data/offline.html /var/www/monero.fail/index.html
